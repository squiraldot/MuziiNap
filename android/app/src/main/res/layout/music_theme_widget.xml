<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_theme_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/music_theme_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/music_theme_widget_character"
        android:layout_width="124dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="30dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/music_theme_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="120dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nothing playing"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/music_theme_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="96dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Play something in MuziiNap"
            android:textColor="#DDFFFFFF"
            android:textSize="12sp"
            android:shadowColor="#CC000000"
            android:shadowRadius="3" />

        <ProgressBar
            android:id="@+id/music_theme_widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="124dp"
            android:max="1000"
            android:progress="0"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp">

            <ImageButton
                android:id="@+id/music_theme_widget_previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Previous track"
                android:padding="8dp"
                android:src="@android:drawable/ic_media_previous" />

            <ImageButton
                android:id="@+id/music_theme_widget_play_pause"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Play or pause"
                android:padding="7dp"
                android:src="@android:drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/music_theme_widget_shuffle"
                android:layout_width="32dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Shuffle"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_sort_by_size" />

            <ImageButton
                android:id="@+id/music_theme_widget_repeat"
                android:layout_width="32dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Repeat"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_rotate" />

            <ImageButton
                android:id="@+id/music_theme_widget_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Next track"
                android:padding="8dp"
                android:src="@android:drawable/ic_media_next" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/music_theme_widget_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
</FrameLayout>
