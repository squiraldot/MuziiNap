<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="LaunchTheme" parent="Theme.SplashScreen" tools:ignore="DuplicateDefinition">
        <item name="windowSplashScreenBackground">@color/splash_screen_background_color</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen_empty</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
